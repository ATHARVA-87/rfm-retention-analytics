		summarizeBy: none
		sourceColumn: meaning

		annotation SummarizationSetBy = Automatic

	column 'Segment Colour' =
			SWITCH (
				segment_rules[segment],
				"Champions", "#6E1E2B",
				"Loyal", "#A35560",
				"New", "#B08A3E",
				"Needs Attention", "#D9B86C",
				"At Risk", "#D6452B",
				"Lost", "#8C8580"
			)
		dataType: string
		lineageTag: e2e99fef-a956-4d4f-a743-5e3421268f97
		summarizeBy: none

	column 'R Range' =
			IF (
				segment_rules[r_min] = segment_rules[r_max],
				FORMAT ( segment_rules[r_min], "0" ),
				segment_rules[r_min] & "–" & segment_rules[r_max]
			)
		dataType: string
		lineageTag: 4107deba-cd2e-4836-9d7e-eea525463f4c
		summarizeBy: none

	column 'F Range' =
			IF (
				segment_rules[f_min] = segment_rules[f_max],
				FORMAT ( segment_rules[f_min], "0" ),
				segment_rules[f_min] & "–" & segment_rules[f_max]
			)
		dataType: string
		lineageTag: 68201e99-2ee7-4fd4-825e-2829f56294c4
		summarizeBy: none

	column Action =
			SWITCH (
				segment_rules[segment],
				"Champions", "Account management for top spenders; alert at 60 days without an order",
				"Loyal", "Re-order reminder and volume pricing for those past 90 days; cross-sell the rest",
				"New", "Second-order offer to one-order customers",
				"Needs Attention", "Automated reminder emails, no discounts",
				"At Risk", "Personal win-back for high spenders; time-limited offer for those lapsed under a year",
				"Lost", "One reactivation email, then suppress from paid campaigns"
			)
		dataType: string
		lineageTag: 7bc3964c-edd6-490c-96f2-aa35382d049b
		summarizeBy: none

	partition segment_rules = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost", "retail"),
				  #"Navigation 1" = Source{[Schema = "public", Item = "segment_rules"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

